+    let prefix = Buffer.alloc(0);
+    let media;
+    const check = new Transform({
+      transform(chunk, encoding, callback) {
+        try {
+          bytes += chunk.length;
+          if (bytes > maximumBytes) throw new SnapYTError('FILE_TOO_LARGE', 'The download exceeds maxBytes.', { stage: 'download' });
