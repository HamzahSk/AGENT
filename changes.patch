+  const limit = new Transform({
+    transform(chunk, encoding, callback) {
+      bytes += chunk.length;
+      callback(bytes > maximumBytes ? new SnapYTError('FILE_TOO_LARGE', 'The converted MP3 exceeds maxBytes.', { stage: 'conversion' }) : null, chunk);
+    },
+  });
