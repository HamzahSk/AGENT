diff --git a/snapyt/test/helpers.mjs b/snapyt/test/helpers.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bfdf91853d61cb83ab9d95a9e2d03fb1e19fd542
--- /dev/null
+++ b/snapyt/test/helpers.mjs
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { mkdtemp, readFile, readdir, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { SnapYTClient } from '../index.mjs';
+import { ORIGIN } from '../protocol.mjs';
+
+export const testUrl = 'https://youtu.be/PqtggjVAi8M';
+export const clip = await readFile(new URL('./fixtures/clip.mp4', import.meta.url));
+export const mp3 = await readFile(new URL('./fixtures/tone.mp3', import.meta.url));
+export const webm = await readFile(new URL('./fixtures/tone.webm', import.meta.url));
+export const videoFormat = { id: '18', label: '360p MP4 with audio', body: clip, mime: 'video/mp4' };
+export const mp3Format = { id: 'mp3', label: 'MP3 128kbps', body: mp3, mime: 'audio/mpeg' };
+export const webmFormat = { id: '251', label: 'Audio only 128kbps', body: webm, mime: 'audio/webm' };
+
+// All values in these HTML fixtures are synthetic. Never record a live session
+// or live request nonce in a test fixture.
+export function forceUrl(id) {
+  return ORIGIN + '/wp-admin/admin-ajax.php?' + new URLSearchParams({
+    action: 'snapyt_force_download', pid: 'fixture-video', fmt: id, nonce: 'fixture-nonce',
+  });
+}
+
+export function resultHtml(formats, title = 'Original test clip') {
+  return '<html><head><meta content="' + title + '" property="og:title"></head><body>' +
+    formats.map(format => '<a data-force="' + forceUrl(format.id).replaceAll('&', '&amp;') + '">' + format.label + '</a>').join('') +
+    '</body></html>';
+}
+
+export async function startSite(t, options = {}) {
+  const directory = await mkdtemp(join(tmpdir(), 'snapyt-test-'));
+  const outputDir = join(directory, 'downloads');
+  const formats = options.formats ?? [videoFormat, webmFormat];
+  const state = { requests: [], forms: [], errors: [] };
+  const server = createServer((request, response) => {
+    void (async () => {
+      const url = new URL(request.url, ORIGIN);
+      state.requests.push({
+        method: request.method, path: url.pathname, format: url.searchParams.get('fmt'),
+        host: request.headers['x-fixture-host'], cookie: request.headers.cookie,
+      });
+      if (await options.route?.(request, response, url, state)) return;
+      if (url.pathname === '/id/') {
+        response.setHeader('content-type', 'text/html');
+        response.setHeader('set-cookie', 'fixture_visitor=anonymous; Path=/; Secure; HttpOnly');
+        response.end(options.landing ?? '<html><title>SnapYT fixture</title><script>const VD_NONCE = "fixture-nonce";</script></html>');
+      } else if (url.pathname === '/wp-admin/admin-ajax.php' && request.method === 'POST') {
+        let form = '';
+        for await (const chunk of request) form += chunk;
+        state.forms.push(Object.fromEntries(new URLSearchParams(form)));
+        response.setHeader('content-type', 'application/json');
+        response.end(options.ajax ?? JSON.stringify({ success: true, data: { redirect_url: '/fixture-result/' } }));
+      } else if (url.pathname === '/fixture-result/') {
+        response.setHeader('content-type', 'text/html');
+        response.end(options.result ?? resultHtml(formats, options.title));
+      } else if (url.searchParams.get('action') === 'snapyt_force_download') {
+        const format = formats.find(candidate => candidate.id === url.searchParams.get('fmt'));
+        if (!format) { response.writeHead(404).end(); return; }
+        response.setHeader('content-type', format.mime);
+        response.setHeader('content-length', format.body.length);
+        response.end(format.body);
+      } else {
+        response.writeHead(404).end();
+      }
+    })().catch(error => {
+      state.errors.push(error);
+      response.writeHead(500).end('Fixture server failed');
+    });
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(async () => {
+    server.closeAllConnections();
+    await new Promise(resolve => server.close(resolve));
+    await rm(directory, { recursive: true, force: true });
+    assert.equal(state.errors.length, 0, 'fixture server must not fail');
+  });
+  const origin = 'http://127.0.0.1:' + server.address().port;
+  const fetchImpl = (input, init) => {
+    const url = new URL(input);
+    const headers = new Headers(init.headers);
+    headers.set('x-fixture-host', url.hostname);
+    return fetch(origin + url.pathname + url.search, { ...init, headers });
+  };
+  const client = new SnapYTClient({ ...options.client, fetchImpl });
+  return {
+    client, directory, outputDir, state,
+    files: async () => {
+      try { return await readdir(outputDir); } catch (error) { if (error.code === 'ENOENT') return []; throw error; }
+    },
+  };
+}
diff --git a/snapyt/test/snapyt.test.mjs b/snapyt/test/snapyt.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2ac984f0628a30edb1c07fd8da96d24c4606e266
--- /dev/null
+++ b/snapyt/test/snapyt.test.mjs
@@ -0,0 +1,351 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { readFile, writeFile } from 'node:fs/promises';
+import { basename, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { SnapYTClient, SnapYTError, normalizeYouTubeUrl } from '../index.mjs';
+import { parseResultPage } from '../protocol.mjs';
+import { clip, mp3, webm, testUrl, videoFormat, mp3Format, webmFormat, resultHtml, startSite } from './helpers.mjs';
+
+const execute = promisify(execFile);
+const ffmpeg = process.env.SNAPYT_TEST_FFMPEG;
+const needsFfmpeg = { skip: ffmpeg ? false : 'Set SNAPYT_TEST_FFMPEG to run real conversion checks.' };
+const codeIs = code => error => error instanceof SnapYTError && error.code === code;
+
+test('YouTube URL validation accepts individual videos and rejects ambiguous or unsafe input', async () => {
+  for (const url of [
+    testUrl, testUrl + '?si=ignored',
+    'https://www.youtube.com/watch?v=PqtggjVAi8M&list=ignored',
+    'http://m.youtube.com/watch?v=PqtggjVAi8M',
+    'https://music.youtube.com/watch?v=PqtggjVAi8M',
+    'https://youtube.com/shorts/PqtggjVAi8M',
+    'https://youtube.com/embed/PqtggjVAi8M',
+  ]) assert.deepEqual(normalizeYouTubeUrl(url), { id: 'PqtggjVAi8M', url: 'https://www.youtube.com/watch?v=PqtggjVAi8M' });
+  const client = new SnapYTClient({ fetchImpl: () => { assert.fail('invalid inputs must not make a request'); } });
+  for (const url of [
+    undefined, '', 'not a URL', 'file:///etc/passwd',
+    'https://youtube.com.attacker.invalid/watch?v=PqtggjVAi8M',
+    'https://youtube.com@attacker.invalid/watch?v=PqtggjVAi8M',
+    'https://user:pass@youtube.com/watch?v=PqtggjVAi8M',
+    'https://youtu.be/PqtggjVAi8M/extra',
+    'https://youtu.be/too-short',
+    'https://youtube.com/playlist?list=anything',
+    'https://youtube.com/watch?v=PqtggjVAi8M&v=PqtggjVAi8M',
+    'https://youtube.com:8443/watch?v=PqtggjVAi8M',
+  ]) await assert.rejects(client.download(url), codeIs('INVALID_URL'));
+  for (const options of [{ timeoutMs: 0 }, { timeoutMs: 2 ** 32 }, { maxBytes: Infinity }, { ffmpegPath: '' }, { fetchImpl: null }]) {
+    assert.throws(() => new SnapYTClient(options), codeIs('INVALID_OPTION'));
+  }
+  await assert.rejects(client.download(testUrl, { type: 'zip' }), codeIs('INVALID_OPTION'));
+  await assert.rejects(client.download(testUrl, { format: 18 }), codeIs('INVALID_OPTION'));
+  await assert.rejects(client.download(testUrl, { outputDir: '' }), codeIs('INVALID_OPTION'));
+  await assert.rejects(client.getInfo(testUrl, { signal: {} }), codeIs('INVALID_OPTION'));
+});
+
+test('metadata uses the nonce/AJAX/result flow without exposing transient request data', async t => {
+  const site = await startSite(t);
+  const info = await site.client.getInfo(testUrl);
+  assert.equal(info.title, 'Original test clip');
+  assert.deepEqual(info.formats.map(format => [format.id, format.type]), [['18', 'video'], ['251', 'audio']]);
+  assert.deepEqual(site.state.requests.map(request => request.method), ['GET', 'POST', 'GET']);
+  assert.deepEqual(site.state.forms, [{
+    action: 'process_video_url', video_url: 'https://www.youtube.com/watch?v=PqtggjVAi8M', security: 'fixture-nonce',
+  }]);
+  assert.equal(site.state.requests[1].cookie, 'fixture_visitor=anonymous');
+  assert.equal(site.state.requests[2].cookie, 'fixture_visitor=anonymous');
+  assert.doesNotMatch(JSON.stringify(info), /fixture-nonce|fixture_visitor|data-force|snapyt_force_download/);
+  assert.deepEqual(await site.files(), []);
+});
+
+test('passive Cloudflare JavaScript on a normal public page is not an access challenge', async t => {
+  const site = await startSite(t, {
+    landing: '<title>SnapYT</title><script>const VD_NONCE = "fixture-nonce";</script>' +
+      '<script src="/cdn-cgi/challenge-platform/scripts/jsd/main.js"></script>',
+  });
+  const info = await site.client.getInfo(testUrl);
+  assert.equal(info.formats.length, 2);
+  assert.equal(site.state.requests.length, 3);
+});
+
+test('real MP4 bytes stream to complete files, including simultaneous filename collisions', async t => {
+  const site = await startSite(t, { title: '../../CON &amp; blue &#x1f3b5;' });
+  const results = await Promise.all([
+    site.client.download(testUrl, { outputDir: site.outputDir }),
+    site.client.download(testUrl, { outputDir: site.outputDir }),
+  ]);
+  assert.notEqual(results[0].file, results[1].file);
